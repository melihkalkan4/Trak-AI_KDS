* Open the main SPSS data file and run hierarchical multiple regression with moderation.

GET FILE='C:\Users\Melih Kalkan\Downloads\Melisa Spss Araştırma Yöntemleri 2\spss yemi versiyon.sav'.

RECODE OZY2 OZY4 OZY5 OZY6 OZY7 OZY10 OZY11 OZY12 OZY14 OZY16 OZY17
  (1=5)(2=4)(3=3)(4=2)(5=1)(ELSE=SYSMIS)
  INTO ROZY2 ROZY4 ROZY5 ROZY6 ROZY7 ROZY10 ROZY11 ROZY12 ROZY14 ROZY16 ROZY17.

RECODE GK2 GK4 GK6 GK8 GK10 GK12
  (1=5)(2=4)(3=3)(4=2)(5=1)(ELSE=SYSMIS)
  INTO RGK2 RGK4 RGK6 RGK8 RGK10 RGK12.

COMPUTE OZYM = MEAN(OZY1, ROZY2, OZY3, ROZY4, ROZY5, ROZY6, ROZY7, OZY8, OZY9, ROZY10, ROZY11, ROZY12, OZY13, ROZY14, OZY15, ROZY16, ROZY17).
COMPUTE GKM = MEAN(GK1, RGK2, GK3, RGK4, GK5, RGK6, GK7, RGK8, GK9, RGK10, GK11, RGK12, GK13, GK14, GK15, GK16, GK17, GK18, GK19).
COMPUTE BTOM = MEAN(BTO1, BTO2, BTO3, BTO4, BTO5, BTO6, BTO7, BTO8, BTO9, BTO10, BTO11, BTO12).
EXECUTE.

AGGREGATE
  /OUTFILE=* MODE=ADDVARIABLES
  /BREAK=
  /BTOMG=MEAN(BTOM)
  /OZYMG=MEAN(OZYM).

COMPUTE BTOC = BTOM - BTOMG.
COMPUTE OZYC = OZYM - OZYMG.
COMPUTE BTOXOZY = BTOC * OZYC.
EXECUTE.

DESCRIPTIVES VARIABLES=BTOM OZYM GKM
  /STATISTICS=MEAN STDDEV MIN MAX.

CORRELATIONS
  /VARIABLES=BTOM OZYM GKM
  /PRINT=TWOTAIL NOSIG
  /MISSING=PAIRWISE.

RELIABILITY
  /VARIABLES=OZY1 ROZY2 OZY3 ROZY4 ROZY5 ROZY6 ROZY7 OZY8 OZY9 ROZY10 ROZY11 ROZY12 OZY13 ROZY14 OZY15 ROZY16 ROZY17
  /SCALE('OZY') ALL
  /MODEL=ALPHA.

RELIABILITY
  /VARIABLES=GK1 RGK2 GK3 RGK4 GK5 RGK6 GK7 RGK8 GK9 RGK10 GK11 RGK12 GK13 GK14 GK15 GK16 GK17 GK18 GK19
  /SCALE('GK') ALL
  /MODEL=ALPHA.

RELIABILITY
  /VARIABLES=BTO1 BTO2 BTO3 BTO4 BTO5 BTO6 BTO7 BTO8 BTO9 BTO10 BTO11 BTO12
  /SCALE('BTO') ALL
  /MODEL=ALPHA.

REGRESSION
  /MISSING LISTWISE
  /STATISTICS COEFF OUTS R ANOVA CHANGE COLLIN TOL CI(95)
  /DEPENDENT GKM
  /METHOD=ENTER BTOC OZYC
  /METHOD=ENTER BTOXOZY
  /RESIDUALS DURBIN HISTOGRAM(ZRESID) NORMPROB(ZRESID)
  /SCATTERPLOT=(*ZPRED,*ZRESID).

SAVE OUTFILE='C:\Users\Melih Kalkan\Desktop\Trak-AI_KDS\outputs\spss_moderation\puanlanmis_spss_veri.sav'
  /COMPRESSED.
