* Hierarchical multiple regression with moderation.
* Run this on the active SPSS data set that contains OZY1-OZY17, GK1-GK19, BTO1-BTO12.

RECODE OZY2 OZY4 OZY5 OZY6 OZY7 OZY10 OZY11 OZY12 OZY14 OZY16 OZY17 (1=5)(2=4)(3=3)(4=2)(5=1)(ELSE=SYSMIS)
  INTO OZY2_R OZY4_R OZY5_R OZY6_R OZY7_R OZY10_R OZY11_R OZY12_R OZY14_R OZY16_R OZY17_R.

RECODE GK2 GK4 GK6 GK8 GK10 GK12 (1=5)(2=4)(3=3)(4=2)(5=1)(ELSE=SYSMIS)
  INTO GK2_R GK4_R GK6_R GK8_R GK10_R GK12_R.

COMPUTE OZY_M = MEAN(OZY1, OZY2_R, OZY3, OZY4_R, OZY5_R, OZY6_R, OZY7_R, OZY8, OZY9, OZY10_R, OZY11_R, OZY12_R, OZY13, OZY14_R, OZY15, OZY16_R, OZY17_R).
COMPUTE GK_M = MEAN(GK1, GK2_R, GK3, GK4_R, GK5, GK6_R, GK7, GK8_R, GK9, GK10_R, GK11, GK12_R, GK13, GK14, GK15, GK16, GK17, GK18, GK19).
COMPUTE BTO_M = MEAN(BTO1, BTO2, BTO3, BTO4, BTO5, BTO6, BTO7, BTO8, BTO9, BTO10, BTO11, BTO12).
EXECUTE.

AGGREGATE
  /OUTFILE=* MODE=ADDVARIABLES
  /BREAK=
  /BTO_GRAND=MEAN(BTO_M)
  /OZY_GRAND=MEAN(OZY_M).

COMPUTE BTO_C = BTO_M - BTO_GRAND.
COMPUTE OZY_C = OZY_M - OZY_GRAND.
COMPUTE BTO_X_OZY = BTO_C * OZY_C.
EXECUTE.

RELIABILITY
  /VARIABLES=OZY1 OZY2_R OZY3 OZY4_R OZY5_R OZY6_R OZY7_R OZY8 OZY9 OZY10_R OZY11_R OZY12_R OZY13 OZY14_R OZY15 OZY16_R OZY17_R
  /SCALE('OZY') ALL
  /MODEL=ALPHA.

RELIABILITY
  /VARIABLES=GK1 GK2_R GK3 GK4_R GK5 GK6_R GK7 GK8_R GK9 GK10_R GK11 GK12_R GK13 GK14 GK15 GK16 GK17 GK18 GK19
  /SCALE('GK') ALL
  /MODEL=ALPHA.

RELIABILITY
  /VARIABLES=BTO1 BTO2 BTO3 BTO4 BTO5 BTO6 BTO7 BTO8 BTO9 BTO10 BTO11 BTO12
  /SCALE('BTO') ALL
  /MODEL=ALPHA.

REGRESSION
  /MISSING LISTWISE
  /STATISTICS COEFF OUTS R ANOVA CHANGE COLLIN TOL CI(95)
  /DEPENDENT GK_M
  /METHOD=ENTER BTO_C OZY_C
  /METHOD=ENTER BTO_X_OZY
  /RESIDUALS DURBIN HISTOGRAM(ZRESID) NORMPROB(ZRESID)
  /SCATTERPLOT=(*ZPRED,*ZRESID).
